# The server reads process environment only; `make run` and `docker compose` load .env for it.
ADDR=:8080
# Leave empty to run locally with deterministic template explanations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional separate tool-capable model for the advisor; empty uses OPENAI_MODEL.
OPENAI_AGENT_MODEL=
# Autopilot roles use these overrides, then OPENAI_AGENT_MODEL / OPENAI_MODEL.
OPENAI_MASTER_MODEL=
OPENAI_PLANNER_MODEL=
OPENAI_REVIEWER_MODEL=
# Local autopilot cost estimates only; separate from provider billing / other endpoints.
AUTOPILOT_RUN_BUDGET_USD=0.10
AUTOPILOT_TOTAL_BUDGET_USD=50
AUTOPILOT_MAX_ITERATIONS=3
# Keep this file across restarts; mount a persistent volume when using Docker.
AUTOPILOT_BUDGET_FILE=.autopilot/usage.json
# Both required for models without built-in prices (USD per 1 million tokens).
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Set BOTH to enable NVIDIA explanations/backup and independent scenario review.
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Exact frontend origin, e.g. http://localhost:5173. Empty disables CORS.
CORS_ORIGIN=
